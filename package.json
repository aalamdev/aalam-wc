{
  "name": "aalam-wc",
  "description": "aalam-wc is a Javascript library for building user interface.",
  "version": "0.0.18",
  "keywords": [
    "aalam-wc",
    "aalam web components"
  ],
  "homepage": "https://www.aalam.io",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
      ".": "./dist/index.js"
  },
  "files": [
      "dist",
      "README.md",
      "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aalamdev/aalam-wc.git"
  },
  "bugs": {
      "url": "https://github.com/aalamdev/aalam-wc/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --outDir dist && vite build",
    "test": "wtr --config web-test-runner.config.js tests/* --node-resolve",
    "test:watch": "wtr --config web-test-runner.config.js tests/* --node-resolve --watch",
    "preview": "vite preview"
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@open-wc/testing": "^5.0.0",
    "@vitejs/plugin-legacy": "^8.2.1",
    "@web/dev-server-esbuild": "^2.0.0",
    "@web/test-runner": "^1.0.0",
    "@web/test-runner-commands": "^1.0.1",
    "@web/test-runner-playwright": "^1.0.0",
    "@web/test-runner-puppeteer": "^1.0.0",
    "sinon": "^22.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  }
}
